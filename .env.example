# PrefPairs configuration. Copy to .env and adjust; .env is git-ignored.
# Nothing here is required: every command runs offline with deterministic defaults.

# SQLite database used by the CLI and the web UI.
PREFPAIRS_DB=.prefpairs/prefpairs.db

# Seed for randomized left/right order, control-pair injection and bootstrap resampling.
PREFPAIRS_SEED=0

# Optional: an OpenAI-compatible endpoint used only to generate candidate responses.
# Leave unset to use the built-in deterministic stub generator.
# PREFPAIRS_LLM_BASE_URL=http://localhost:8000/v1
# PREFPAIRS_LLM_API_KEY=
# PREFPAIRS_LLM_MODEL=
